---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import ProjectLinks from "../components/ProjectLinks.astro";

// Parse "YYYY-MM" or any Date-compatible string; undefined -> 0
const toTime = (s?: string) => {
  if (!s) return 0;
  const iso = /^\d{4}-\d{2}$/.test(s) ? `${s}-01` : s;
  const t = new Date(iso).getTime();
  return Number.isNaN(t) ? 0 : t;
};

const projects = (await getCollection("projects"))
  .slice()
  .sort((a, b) =>
    (Number(b.data.featured) - Number(a.data.featured)) || // featured first
    (a.slug === "book-recsys" ? -1 : b.slug === "book-recsys" ? 1 : 0) || // flagship project leads
    (toTime(b.data.date) - toTime(a.data.date)) ||         // newest -> oldest
    a.slug.localeCompare(b.slug)
  );
---
<Base title="Projects — Simon Bouchard">
  <h1 class="text-2xl font-bold mb-6">Projects</h1>
  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((p) => (
      <article
        class={`relative rounded-2xl p-5 hover:shadow-sm transition ${
          p.data.featured
            ? "border border-blueprint/40 bg-blueprint/5 ring-1 ring-blueprint/20"
            : "border border-line hover:border-blueprint/40"
        }`}
      >
        <a href={`/projects/${p.slug}/`} class="block after:absolute after:inset-0 after:z-0">
          <h2 class="text-lg font-semibold flex flex-wrap items-center gap-2">
            <img
              src={p.data.icon ?? `/projects/${p.slug}/icon.png`}
              alt=""
              class="size-5 rounded"
            />
            {p.data.title}
            {p.data.featured && (
              <span class="text-[10px] font-mono font-medium rounded-md px-1.5 py-0.5 bg-blueprint text-paper shadow-sm">
                Featured
              </span>
            )}
          </h2>
          <p class="mt-2 text-sm opacity-90">{p.data.description}</p>
        </a>
        <div class="mt-3 flex flex-wrap gap-2">
          {p.data.stack.slice(0, 5).map((s) => (
            <span class="text-xs px-2 py-1 rounded-full border border-line font-mono text-ink/80">
              {s}
            </span>
          ))}
        </div>
        <div class="mt-4">
          <ProjectLinks demo={p.data.demo} repo={p.data.repo} size="sm" />
        </div>
      </article>
    ))}
  </div>
</Base>
