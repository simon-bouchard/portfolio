---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import ProjectLinks from "../components/ProjectLinks.astro";
import { certifications } from "../data/certifications";

// Featured projects for the homepage grid
const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .slice(0, 4);
---

<Base
  title="Simon Bouchard | LLM Agents & Backend Developer"
  description="Agentic AI systems, FastAPI backends, and data-intensive pipelines.">
  <!-- HERO -->
  <section class="grid md:grid-cols-2 gap-10 items-start">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-blueprint mb-3">Agentic AI / Backend / Data Pipelines</p>
      <h1 class="text-4xl font-bold leading-tight">LLM Agents & Backend Developer</h1>

      <p class="mt-4 text-lg opacity-90">
        I build production-ready backends and <strong>agentic AI systems</strong> that combine retrieval,
        tool use, and orchestration with solid data engineering. My business + IT background
        (HEC Montréal, bilingual program) helps connect technical delivery to product outcomes.
      </p>

      <p class="mt-3 opacity-90">
        Recently, I shipped an agentic workflow on top of a FastAPI stack: retrieval-augmented generation,
        vector search, and tool-calling (search, internal ML services, data lookups), all behind
        authenticated endpoints with observability and safe fallbacks. Earlier work includes an end-to-end
        book platform (normalized SQL, embedding pipelines, and automated training/rollouts), which I now
        leverage as one of several tools inside the agent system.
      </p>

      <!-- Key skills (chips) -->
      <ul class="mt-5 flex flex-wrap gap-2">
        {[
          "Python","FastAPI","LLM Agents","RAG","Vector Search",
          "PyTorch","LightGBM","SQL","Linux/Nginx","Docker","AWS","Git",
          "Scikit", "Langraph", "Spark"
        ].map((s) => (
          <li class="text-xs px-2 py-1 rounded-full border border-line font-mono opacity-90">{s}</li>
        ))}
      </ul>

      <!-- CTAs -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/projects/" class="px-4 py-2 rounded-lg bg-blueprint text-paper font-mono text-sm hover:opacity-90 transition">Projects</a>
        <!-- <a href="/experience/" class="px-4 py-2 rounded-lg border border-line font-mono text-sm hover:border-blueprint hover:text-blueprint transition">Experience</a> -->
        <a href="/contact/" class="px-4 py-2 rounded-lg border border-line font-mono text-sm hover:border-blueprint hover:text-blueprint transition">Links</a>
        <a href="/about/" class="px-4 py-2 rounded-lg border border-line font-mono text-sm hover:border-blueprint hover:text-blueprint transition">About</a>
      </div>

      <p class="mt-4 text-sm opacity-75">
        Currently exploring: robust agent design (planning, tool routing, memory) and
        modern C++ (concurrency, memory model, RAII) to deepen my low-level systems understanding.
      </p>
    </div>

    <!-- Quick highlights -->
    <div class="space-y-4">
      <!-- Resume -->
      <div class="border border-line rounded-2xl p-5 space-y-3">
        <h3 class="text-sm font-semibold text-ink">Resume</h3>
        <p class="text-sm opacity-85">Available as a two-page PDF, in English or French.</p>
        <div class="flex gap-3">
          <a href="/resume-en.pdf" target="_blank" rel="noopener noreferrer"
             class="flex-1 text-center px-4 py-2 rounded-lg bg-blueprint text-paper font-mono text-sm hover:opacity-90 transition">
            Resume (EN) ↓
          </a>
          <a href="/resume-fr.pdf" target="_blank" rel="noopener noreferrer"
             class="flex-1 text-center px-4 py-2 rounded-lg border border-line font-mono text-sm hover:border-blueprint hover:text-blueprint transition">
            CV (FR) ↓
          </a>
        </div>
      </div>

      <div class="border border-line rounded-2xl p-5 space-y-4">
        <div>
          <div class="text-sm font-semibold">Agentic Systems</div>
          <p class="text-sm opacity-85">
            RAG pipelines with tool-calling: web/data search, internal ML tools, and guarded execution
            with structured prompts, schemas, and evaluation.
          </p>
        </div>
        <div>
          <div class="text-sm font-semibold">APIs & Serving</div>
          <p class="text-sm opacity-85">
            FastAPI services with caching, pagination, auth, and observability; deployed behind Nginx with safe hot reloads.
          </p>
        </div>
        <div>
          <div class="text-sm font-semibold">Data Engineering & MLOps</div>
          <p class="text-sm opacity-85">
            SQL modeling, feature prep, scheduled jobs, artifact promotion, and environment-aware rollouts.
          </p>
        </div>
      </div>

      <!-- Certifications -->
      <div class="border border-line rounded-2xl p-5 space-y-3 bg-gradient-to-br from-blueprint/5 to-blueprint/10">
        <h3 class="text-sm font-semibold text-ink">Certifications</h3>
        <div class="space-y-3">
          {certifications.map((cert) => (
            <div class="flex gap-3 items-start">
              <img
                src={cert.badge}
                alt={`${cert.name} badge`}
                class="size-15 rounded flex-shrink-0"
              />
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium leading-tight">{cert.name}</div>
                <div class="text-xs opacity-75 mt-1">
                  {cert.details && <span>{cert.details} | </span>}
                  <span>{cert.issued}</span>
                </div>
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-mono text-blueprint hover:opacity-80 hover:underline inline-flex items-center gap-1 mt-1"
                >
                  Verify →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured projects (internal links to detail pages) -->
  {featured.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-semibold mb-4">Featured</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {featured.map((p) => (
          <article class="border border-line rounded-2xl p-5 hover:border-blueprint/40 hover:shadow-sm transition">
            <a href={`/projects/${p.slug}/`} class="block">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold flex items-center gap-2">
                  <img src={`/projects/${p.slug}/icon.png`} alt="" class="size-5 rounded" />
                  {p.data.title}
                </h3>
                <span class="text-xs opacity-70">{p.data.date ?? ""}</span>
              </div>
              <p class="mt-2 text-sm opacity-90">{p.data.description}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {p.data.stack.slice(0,5).map((s) => (
                  <span class="text-xs px-2 py-1 rounded-full border border-line font-mono opacity-80">{s}</span>
                ))}
              </div>
            </a>
            <div class="mt-4">
              <ProjectLinks demo={p.data.demo} repo={p.data.repo} size="sm" />
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Base>
